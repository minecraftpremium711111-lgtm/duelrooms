name : Build
on :
   push:
   workflow_dispatch:
 jobs :
  Build:
  runs-on : ubuntu-latest
  defaults :
  run :
  working-directory : DuelRooms-with-github-build
  steps :
  - uses : actions/checkout@v4
  - uses : actions/setup-java@v4
    with : 
    distribution : temurin
    java-version : '21'
- run : mvn -B clean package
-uses : actions/upload-artifact@v4
with :
name : DuelRooms-jar
patch: DuelRooms-with-github-build/target/DuelRooms-1.0.0.jar
